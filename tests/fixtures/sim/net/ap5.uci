dhcp.cfg01411c.filter_a='0'
dhcp.lan=dhcp
dhcp.lan.interface='lan'
dhcp.lan.start='100'
dhcp.lan.limit='150'
dhcp.lan.leasetime='12h'
dhcp.lan.ra='disabled'
dhcp.lan.dhcpv4='server'
dhcp.lan.dhcpv6='disabled'
